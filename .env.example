MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hoangdaika13_site
JWT_SECRET=replace-with-at-least-32-random-characters
# Same-site Vercel hosting should keep this at Lax (or Strict). Use None only
# when a separate trusted frontend must send the session cookie cross-site.
SESSION_COOKIE_SAMESITE=Lax
REALTIME_SERVER_URL=https://hoangdaika13-astra-realtime.onrender.com
ADMIN_EMAILS=owner@example.com
# Optional immutable MongoDB user IDs for break-glass owner access.
ADMIN_USER_IDS=
# Backward-compatible single address; ADMIN_EMAILS is preferred.
ADMIN_EMAIL=
ALLOWED_ORIGINS=https://hoang8.com,https://www.hoang8.com,https://hoangdaika13-github-io.vercel.app
FRONTEND_URL=https://hoang8.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://hoang8.com/api/auth/google/callback
# Authentication security. Generate AUTH_OTP_SECRET as a random 32+ character value.
AUTH_OTP_SECRET=
EMAIL_FROM=HH Platform <account@hoang8.com>
HH_EMAIL_FROM=HH Platform <account@hoang8.com>
PASSKEY_RP_ID=hoang8.com
PASSKEY_RP_NAME=HH Platform
PASSKEY_ORIGINS=https://hoang8.com,https://www.hoang8.com
# Adaptive CAPTCHA is rendered only after suspicious failed sign-ins.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Dedicated OAuth callback for YouTube Publisher. Add this exact URL to the
# Google OAuth client's Authorized redirect URIs.
YOUTUBE_CALLBACK_URL=https://hoang8.com/api/youtube/oauth/callback
# Server-only encryption secret for Google access/refresh tokens (32+ random characters).
YOUTUBE_TOKEN_ENCRYPTION_KEY=
# Meta Pages API. Add META_CALLBACK_URL to Valid OAuth Redirect URIs in the
# Meta developer dashboard. All Page access tokens stay encrypted server-side.
META_APP_ID=
META_APP_SECRET=
META_CALLBACK_URL=https://hoang8.com/api/facebook/oauth/callback
# Dedicated 32+ character secret. Do not reuse JWT or YouTube encryption keys.
META_TOKEN_ENCRYPTION_KEY=
# During key rotation only: comma-separated former keys; remove after every stored token has migrated to v2.
META_TOKEN_ENCRYPTION_KEY_PREVIOUS=
META_WEBHOOK_VERIFY_TOKEN=
# Keep configurable so Graph API upgrades do not require exposing a client secret.
META_GRAPH_VERSION=v23.0
# Server-only keys for the integrated Search & Watch Center.
# Create these in Google Cloud / Programmable Search, then add them in Vercel.
YOUTUBE_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Shared durable API gateway limits. Values are server-side only; YouTube
# search costs 101 quota units (search.list + videos.list), resource reads cost 1.
GOOGLE_SEARCH_GATEWAY_DAILY_LIMIT=100
GOOGLE_SEARCH_GATEWAY_RATE_LIMIT=50
YOUTUBE_GATEWAY_DAILY_LIMIT=10000
YOUTUBE_GATEWAY_RATE_LIMIT=40
# Creator OS observed quota ledger. This is an HH-side estimate; Google Cloud
# Console remains authoritative. Override costs as Google revises granular quota.
YOUTUBE_QUOTA_DAILY_LIMIT=10000
YOUTUBE_QUOTA_COSTS_JSON=
# Optional separate salt for anonymized 30-day gateway audit identities.
# When omitted, JWT_SECRET is used. Generate a random 32+ character value.
GATEWAY_AUDIT_SALT=
# Server-only Gemini credentials. Prefer a comma or newline separated pool;
# never expose these values in browser JavaScript or commit them to Git.
# Each key must be from a Google AI project with Gemini API enabled and an
# active quota/billing plan. A quota response cannot be bypassed in code.
GEMINI_API_KEYS=
GEMINI_MAX_KEY_ATTEMPTS=4
# Single-key fallback for an existing deployment.
GEMINI_API_KEY=
# Use a model listed for the same key/project in Google AI Studio.
GEMINI_MODEL=gemini-3.5-flash
# Server-only OpenAI credentials for Creative AI. Never expose these values in
# browser JavaScript. OPENAI_API_KEYS optionally accepts comma/newline-separated
# project keys; OPENAI_API_KEY is the normal single-key setup.
OPENAI_API_KEYS=
OPENAI_API_KEY=
OPENAI_MAX_KEY_ATTEMPTS=2
# auto prefers OpenAI when configured and falls back to Gemini. Set gemini to
# preserve Gemini as the first provider.
CREATIVE_AI_PROVIDER=auto
# Balanced GPT-5.6 model; users can still select Sol or Luna in AI Center.
OPENAI_MODEL=gpt-5.6-terra
# Optional media overrides for the integrated Làm nhạc AI pipeline.
# GEMINI_API_KEYS is reused when these model IDs are available to the account.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
ELEVENLABS_API_KEY=
ELEVEN_MUSIC_MODEL=music_v2
# A separate long-running FFmpeg service is optional for final 1–5 hour renders.
MUSIC_RENDER_API_URL=
MUSIC_RENDER_API_KEY=
# Preferred Google website search provider (Agent Search / Vertex AI Search).
# VERTEX_SEARCH_API_KEY can reuse GOOGLE_SEARCH_API_KEY after Discovery Engine API is allowed on that key.
VERTEX_SEARCH_PROJECT_ID=
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_APP_ID=
VERTEX_SEARCH_API_KEY=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Transactional thank-you email. Verify hoang8.com in Resend first.
# The sender must belong to the verified domain; keys stay server-side in Vercel.
RESEND_API_KEY=
HH_RESEND_API_KEY=
DONATION_FROM_EMAIL=Nhhoang <donate@hoang8.com>
DONATION_REPLY_TO=
PUBLIC_SITE_URL=https://hoang8.com
# Optional S3-compatible object storage for large images, video, audio and files.
# These values stay on Vercel; do not place them in browser JavaScript.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI Video Remake Studio. Gemini is used for planning/storyboards, while Veo
# handles direct text-to-video. Remix and character replacement require a
# separate long-running GPU worker; no provider key is ever sent to the browser.
AI_VIDEO_DIRECTOR_MODEL=
AI_VIDEO_DIRECTOR_USD_PER_REQUEST=
AI_VIDEO_PRICING_VERSION=

# TikTok Creator Galaxy · server-side only
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://hoang8.com/api/tiktok/oauth/callback
TIKTOK_TOKEN_ENCRYPTION_KEY=
TIKTOK_WEBHOOK_SECRET=
# Optional signature age window; allowed range is 60-900 seconds.
TIKTOK_WEBHOOK_TOLERANCE_SECONDS=300
# Set true only after TikTok Content Posting API audit is approved.
TIKTOK_CONTENT_POSTING_AUDITED=false
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_APP_SECRET=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Discord Center · account linking and server-side bot access only.
# Register the exact callback in Discord Developer Portal. Never expose these values in browser code.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=https://hoang8.com/api/discord/oauth/callback
DISCORD_TOKEN_ENCRYPTION_KEY=
DISCORD_BOT_TOKEN=
DISCORD_BOT_PUBLIC_KEY=
# Set true only after enabling Message Content Intent in Discord Developer Portal.
DISCORD_MESSAGE_CONTENT_ENABLED=false
# Comma-separated immutable user IDs allowed to create billable jobs. The site
# owner is allowed automatically. Set AI_VIDEO_ALLOW_USERS=1 only after setting
# per-user job and USD limits below.
AI_VIDEO_BILLING_USER_IDS=
AI_VIDEO_ALLOW_USERS=0
AI_VIDEO_DAILY_JOB_LIMIT=3
AI_VIDEO_DAILY_USD_LIMIT=
AI_VIDEO_ADMIN_DAILY_JOB_LIMIT=50
AI_VIDEO_ADMIN_DAILY_USD_LIMIT=
# Keep these rates aligned with the provider account actually connected to the
# deployment. If blank, the UI displays "price not configured" and requires an
# explicit owner confirmation instead of inventing a price.
VEO_LITE_USD_PER_SECOND=
VEO_FAST_USD_PER_SECOND=
VEO_STANDARD_USD_PER_SECOND=
VEO_ALLOWED_DURATIONS=4,6,8
VEO_ALLOWED_ASPECT_RATIOS=16:9,9:16
VEO_ALLOWED_RESOLUTIONS=720p
# Private GPU worker contract for Gemini Omni, Wan2.2 Animate or a custom
# adapter. Production URLs must use HTTPS; the bearer token should be 32+ random
# characters and must also be configured on the worker.
MEDIA_AI_WORKER_URL=
MEDIA_AI_WORKER_TOKEN=
MEDIA_AI_WORKER_MODES=analyze,video-remix,character-replace,text-to-video
MEDIA_AI_WORKER_PROVIDERS=gemini-omni,wan2.2
MEDIA_AI_WORKER_MODELS=
MEDIA_AI_WORKER_DEFAULT_MODEL=
MEDIA_AI_WORKER_DURATIONS=4,6,8,10
MEDIA_AI_WORKER_ASPECT_RATIOS=16:9,9:16,1:1
MEDIA_AI_WORKER_RESOLUTIONS=720p,1080p
MEDIA_AI_WORKER_MAX_VARIANTS=3
MEDIA_AI_WORKER_USD_PER_SECOND=
MEDIA_AI_WORKER_ANALYSIS_USD_PER_REQUEST=
# Optional comma-separated output hosts when the worker stores results on a
# different trusted HTTPS origin. The worker origin itself is allowed by default.
MEDIA_AI_WORKER_OUTPUT_HOSTS=
# Owner-scoped download proxy hard limit in bytes (default: 100 MiB).
AI_VIDEO_PROXY_MAX_BYTES=104857600

# Comic Reader -> Comic Motion batch bridge. Long renders must run on a
# separate HTTPS FFmpeg/GPU worker; Vercel only coordinates durable jobs.
COMIC_MOTION_WORKER_URL=
COMIC_MOTION_WORKER_TOKEN=
COMIC_MOTION_WORKER_CALLBACK_SECRET=
# Comma-separated HTTPS hostnames allowed to return artifacts. The worker
# hostname is allowed automatically.
COMIC_MOTION_WORKER_OUTPUT_HOSTS=
COMIC_MOTION_HANDOFF_TTL_MINUTES=20
COMIC_MOTION_MAX_BATCH_CHAPTERS=100
COMIC_MOTION_MAX_BATCH_PAGES=2000
COMIC_MOTION_MAX_DAILY_JOBS=20
COMIC_MOTION_MAX_DAILY_MINUTES=
COMIC_MOTION_MAX_DAILY_USD=
# Required only when COMIC_MOTION_MAX_DAILY_USD is enabled.
COMIC_MOTION_WORKER_USD_PER_MINUTE=

# Optional Root Authority adapters. Keep every value server-side.
# Without these values, Admin Panel truthfully leaves the approved request in
# "waiting adapter" state and never pretends an external mutation succeeded.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
PAYOS_REFUND_STATUS_URL=
PAYOS_REFUND_ADAPTER_SECRET=
