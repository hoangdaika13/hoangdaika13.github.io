{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/media/comic-source",
      "destination": "/api/modules/comic-motion/actions?comicSource=1"
    },
    {
      "source": "/api/health",
      "destination": "/api/platform/summary?view=health"
    },
    {
      "source": "/api/tools/run",
      "destination": "/api/store/tool-gateway?gateway=tools"
    },
    {
      "source": "/api/jobs",
      "destination": "/api/store/tool-gateway?gateway=jobs"
    },
    {
      "source": "/api/files",
      "destination": "/api/store/tool-gateway?gateway=files"
    },
    {
      "source": "/api/ai",
      "destination": "/api/store/tool-gateway?gateway=ai"
    },
    {
      "source": "/api/integrations",
      "destination": "/api/store/tool-gateway?gateway=integrations"
    },
    {
      "source": "/api/events",
      "destination": "/api/store/tool-gateway?gateway=events"
    },
    {
      "source": "/api/games",
      "destination": "/api/social?service=games"
    },
    {
      "source": "/api/youtube/:youtubeAction*",
      "destination": "/api/platform/summary?youtubePublisher=1&youtubeAction=:youtubeAction"
    },
    {
      "source": "/api/facebook/:facebookAction*",
      "destination": "/api/platform/summary?facebookPageManager=1&facebookAction=:facebookAction"
    },
    {
      "source": "/api/community-admin",
      "destination": "/api/community?adminRoute=1"
    },
    {
      "source": "/api/privacy/consent",
      "destination": "/api/platform/summary?privacyRoute=consent"
    },
    {
      "source": "/api/votes",
      "destination": "/api/donations?resource=votes"
    },
    {
      "source": "/api/notifications/subscribe",
      "destination": "/api/donations?resource=notification-subscribe"
    },
    {
      "source": "/api/auth/google/callback",
      "destination": "/api/auth/google?oauthCallback=google"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), display-capture=(self), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        { "key": "Origin-Agent-Cluster", "value": "?1" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com https://www.google.com https://www.gstatic.com https://cdn.jsdelivr.net https://cdn.payos.vn https://challenges.cloudflare.com https://cse.google.com https://hoangdaika13-astra-realtime.onrender.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' http://localhost:8765 http://127.0.0.1:8765 https: wss:; frame-src 'self' https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co https://accounts.google.com https://*.payos.vn; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    }
  ]
}
